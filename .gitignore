# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Abstra
# Abstra is an AI-powered process automation framework.
# Ignore directories containing user credentials, local state, and settings.
# Learn more at https://abstra.io/docs
.abstra/

# Visual Studio Code
#  Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#  that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#  and can be added to the global gitignore or merged into this file. However, if you prefer, 
#  you could uncomment the following to ignore the entire vscode folder
# .vscode/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Benchmark dataset images (large, downloaded separately)
datasets/


# Demo recording assets — kept locally, NOT in repo
# Videos, voiceover scripts, slide generators, storyboards
docs/demo_assets/
docs/voiceover/
docs/DEMO_STORYBOARD.md
docs/DEMO_STORYBOARD_v2.md
*.mp4

# Runtime output from examples/demo-run.sh (regenerated on every run;
# audit chain hashes are run-specific, so committing the JSONL files
# would cause spurious dirty-tree noise on every demo invocation).
examples/out/*
!examples/out/find-evil-ref-01/
!examples/out/find-evil-ref-01/**

# Runtime output from analyze.py (out/<tier>/<case>/<timestamp>/).
/out/

# log2timeline/Plaso drops a timestamped log in its cwd on every run
# (e.g. examples/log2timeline-*.log.gz left by sift-adapter-demo.sh).
log2timeline-*.log.gz

# Local working notes (Claude Code only, kept off the remote).
CLAUDE.local.md

# Case-study synthetic evidence (force-included past the generic *.log etc. rules).
!examples/sample-evidence/**
!examples/case-studies/**

# Downloaded external-tier dataset images + their materialized evidence_root
# (large, third-party — never committed). These re-ignore patterns MUST come
# AFTER the !examples/case-studies/** negation above, otherwise the negation
# unignores them. analyze.py --download fetches into the external case
# directory; keep only README.md / truth.json under git.
examples/case-studies/external-evaluation/*/cfreds_hacking_case/
examples/case-studies/external-evaluation/*/hadi_challenge_1/
examples/case-studies/external-evaluation/*/m57_jo/
examples/case-studies/external-evaluation/*/evidence_root/
examples/case-studies/external-evaluation/*/*.E01
examples/case-studies/external-evaluation/*/*.dd
examples/case-studies/external-evaluation/*/SCHARDT.0[0-9]

# Installer-staged tool binaries (EZ Tools, Velociraptor, yara symlink).
# These are downloaded/symlinked by scripts/install.sh, never committed —
# the adapters auto-discover them via _search_repo_bins().
/bin/

# Benchmark output is rendered from docs/benchmarks/ledger.json (the source of
# record) and committed, so the repo always shows the latest recorded values:
# ledger.json + SUMMARY.md + MODEL-COMPARISON.md are all tracked. The legacy
# per-run .rows.json and EXTERNAL-COMPARISON files are no longer produced.
docs/benchmarks/MODEL-COMPARISON.rows.json
docs/benchmarks/EXTERNAL-COMPARISON.md
docs/benchmarks/EXTERNAL-COMPARISON.rows.json
